<Window x:Class="FontStudio.ActivityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FontStudio activity" Width="820" Height="460" MinWidth="640" MinHeight="320" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Activity history" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock Text="Local install and deactivation results. Font file contents are never stored in this log." Foreground="#6E6E73" Margin="0,4,0,0"/>
        </StackPanel>
        <DataGrid x:Name="ActivityGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time (UTC)" Binding="{Binding TimestampUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="145"/>
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="90"/>
                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="170"/>
                <DataGridTextColumn Header="Result" Binding="{Binding Outcome}" Width="85"/>
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="No font-changing activity has been recorded." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#6E6E73" Visibility="Collapsed"/>
        <Button Grid.Row="2" Content="Close" IsCancel="True" HorizontalAlignment="Right" Margin="0,12,0,0"/>
    </Grid>
</Window>
