<Window x:Class="FontStudio.NameDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New collection" Width="380" Height="170" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Collection name" Margin="0,0,0,8"/><TextBox x:Name="NameBox" /></StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True"/><Button Content="Create" IsDefault="True" Click="Create_Click" Background="#1667D9" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
