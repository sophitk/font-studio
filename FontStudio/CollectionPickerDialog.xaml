<Window x:Class="FontStudio.CollectionPickerDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add to collection" Width="380" Height="300" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ListBox x:Name="CollectionList" DisplayMemberPath="Name" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True"/><Button Content="Add" IsDefault="True" Click="Add_Click" Background="#1667D9" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
