<Window x:Class="FontStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FontStudio" Width="1360" Height="840" MinWidth="1040" MinHeight="650"
        Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI" Foreground="{StaticResource InkBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E1E2E6" BorderThickness="0,0,0,1">
            <Grid Margin="18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="9" Background="#1667D9">
                        <TextBlock Text="Aa" Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="FontStudio" Margin="10,0,0,0" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBox x:Name="SearchBox" Grid.Column="1" MaxWidth="520" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                         TextChanged="SearchBox_TextChanged" ToolTip="Search font families" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Utilities" Click="Utilities_Click" />
                    <Button Content="Activity" Click="Activity_Click" />
                    <Button Content="Validate file" Click="ValidateFile_Click" />
                    <Button x:Name="InstallFontButton" Content="Install font…" Click="InstallFont_Click" Background="#1667D9" Foreground="White" BorderBrush="#1667D9" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="470" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#ECEEF2" Padding="14">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Content="+ New collection" Click="NewCollection_Click" Margin="0,12,0,0" />
                    <StackPanel>
                        <TextBlock Text="LIBRARY" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="8,8" />
                        <ListBox x:Name="LibraryList" SelectionChanged="LibraryList_SelectionChanged" BorderThickness="0" Background="Transparent" SelectedIndex="0">
                            <ListBoxItem Content="All fonts" Tag="all" Padding="9" />
                            <ListBoxItem Content="Favorites" Tag="favorites" Padding="9" />
                            <ListBoxItem Content="User fonts" Tag="user" Padding="9" />
                            <ListBoxItem Content="System fonts" Tag="system" Padding="9" />
                            <ListBoxItem Content="Variable fonts" Tag="variable" Padding="9" />
                        </ListBox>
                        <TextBlock Text="COLLECTIONS" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="8,22,8,8" />
                        <ListBox x:Name="CollectionsList" SelectionChanged="CollectionsList_SelectionChanged" BorderThickness="0" Background="Transparent" DisplayMemberPath="Name" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#D5D7DB" />

            <Border Grid.Column="2" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="14,8" LastChildFill="False">
                        <TextBlock x:Name="ListTitle" DockPanel.Dock="Left" Text="All fonts" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </DockPanel>
                    <ListBox x:Name="FontList" Grid.Row="1" SelectionChanged="FontList_SelectionChanged" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,7" Width="420">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FamilyName}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Aa กข 0123" FontFamily="{Binding PreviewFamily}" FontSize="21" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="★" Foreground="#E7A600" FontSize="17" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#D5D7DB" />

            <Border Grid.Column="4" Background="White" Padding="28">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="SelectedName" Text="Select a font" FontSize="24" FontWeight="SemiBold" />
                            <Button x:Name="FavoriteButton" DockPanel.Dock="Right" Content="☆ Favorite" Click="Favorite_Click" IsEnabled="False" />
                        </DockPanel>
                        <TextBox x:Name="PreviewTextBox" Margin="0,22,0,12" TextChanged="PreviewTextBox_TextChanged" />
                        <Slider x:Name="SizeSlider" Minimum="16" Maximum="96" Value="48" TickFrequency="8" IsSnapToTickEnabled="False" />
                        <Border Background="#F7F8FA" CornerRadius="12" Padding="22" Margin="0,14,0,20" MinHeight="210">
                            <TextBlock x:Name="LargePreview" TextWrapping="Wrap" FontSize="48" />
                        </Border>
                        <TextBlock Text="Characters" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock x:Name="GlyphPreview" Text="ABCDEFGHIJKLMNOPQRSTUVWXYZ&#x0a;abcdefghijklmnopqrstuvwxyz&#x0a;0123456789  ! ? @ # $ % &amp; * ( )" TextWrapping="Wrap" FontSize="24" LineHeight="40" Margin="0,10,0,20" />
                        <Separator />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Format" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="FormatText" Grid.Column="1" />
                            <TextBlock Text="Style" Grid.Row="1" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" />
                            <TextBlock x:Name="StyleText" Grid.Row="1" Grid.Column="1" Margin="0,9,0,0" />
                            <TextBlock Text="Version" Grid.Row="2" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" />
                            <TextBlock x:Name="VersionText" Grid.Row="2" Grid.Column="1" Margin="0,9,0,0" />
                            <TextBlock Text="Features" Grid.Row="3" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" />
                            <TextBlock x:Name="FeaturesText" Grid.Row="3" Grid.Column="1" Margin="0,9,0,0" />
                            <TextBlock Text="Location" Grid.Row="4" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" />
                            <TextBlock x:Name="LocationText" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" Margin="0,9,0,0" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="AddToCollectionButton" Content="Add to collection" Click="AddToCollection_Click" IsEnabled="False" />
                            <Button x:Name="DeactivateButton" Content="Deactivate" Click="Deactivate_Click" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#ECEEF2" BorderBrush="#D5D7DB" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,0" LastChildFill="False">
                <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="SafetyModeText" DockPanel.Dock="Right" Text="Read-only pilot" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="18,0,0,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
